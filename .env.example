# Copie para .env e preencha localmente. NÃO commite o arquivo .env.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Super Admin usa Auth + platform_admins no banco. PIN de frontend foi removido.

# PUBLIC (site key). Deixe vazio ou use a key do seu projeto hCaptcha.
VITE_HCAPTCHA_SITE_KEY=

# Loja exibida na página inicial (/). Ex.: beira-rio
VITE_DEFAULT_STORE_SLUG=

# Se "true", / redireciona direto para /{slug} da loja acima
VITE_LANDING_REDIRECT_TO_STORE=
